# Etapa 1: Build do Angular
FROM node:20-alpine AS build

WORKDIR /app

# Copiar arquivos de dependências
COPY package.json package-lock.json* ./

# Instalar dependências
RUN npm ci --legacy-peer-deps

# Copiar código fonte
COPY . .

# Build de produção
RUN npm run build

# Etapa 2: Servir com Nginx
FROM nginx:alpine

# Copiar build do Angular
COPY --from=build /app/dist/poker-rvd/browser /usr/share/nginx/html

# Configuração Nginx (template com __PORT__ para Railway)
COPY nginx.conf.template /etc/nginx/conf.d/default.conf.template

# Entrypoint: gera config.json a partir de API_URL e HUB_URL (env vars)
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80
EXPOSE 8088

ENTRYPOINT ["/entrypoint.sh"]
